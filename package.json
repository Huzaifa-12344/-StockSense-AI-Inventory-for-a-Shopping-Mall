{
  "name": "stocksense-inventory",
  "version": "1.0.0",
  "description": "AI-powered inventory management system for Nowshera Shopping Mall",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "wrangler dev --local",
    "dev:frontend": "vite",
    "build": "npm run build:frontend && npm run build:backend",
    "build:frontend": "vite build",
    "build:backend": "tsc --noEmit && npm run build:frontend",
    "deploy": "npm run build && wrangler deploy",
    "preview": "vite preview",
    "test": "vitest",
    "test:coverage": "vitest --coverage",
    "test:ui": "vitest --ui",
    "lint": "eslint src --ext .ts,.tsx",
    "lint:fix": "eslint src --ext .ts,.tsx --fix",
    "type-check": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.{ts,tsx,json,css}\"",
    "db:shell": "wrangler d1 execute stocksense-db --local",
    "db:migrate": "node scripts/migrate.js",
    "db:create-migration": "node scripts/create-migration.js",
    "db:rollback": "node scripts/rollback.js",
    "db:seed": "node scripts/seed.js",
    "db:status": "node scripts/migration-status.js",
    "logs:backend": "wrangler tail",
    "clean": "rm -rf dist .wrangler node_modules",
    "prebuild": "npm run lint",
    "prepare": "husky install 2>/dev/null || true"
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "hono": "^4.0.0",
    "zod": "^3.22.0",
    "axios": "^1.6.0",
    "clsx": "^2.0.0",
    "lucide-react": "^0.294.0",
    "date-fns": "^2.30.0",
    "zustand": "^4.4.0",
    "sonner": "^1.2.0",
    "openai": "^4.26.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20230821.0",
    "@types/node": "^20.0.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^4.0.0",
    "@testing-library/react": "^14.1.0",
    "@testing-library/jest-dom": "^6.1.0",
    "@testing-library/user-event": "^14.5.0",
    "vitest": "^1.0.0",
    "vite": "^5.0.0",
    "typescript": "^5.0.0",
    "eslint": "^8.50.0",
    "eslint-config-prettier": "^9.0.0",
    "prettier": "^3.0.0",
    "wrangler": "^3.20.0",
    "concurrently": "^8.2.0",
    "tsx": "^4.7.0",
    "husky": "^8.0.0",
    "lint-staged": "^15.0.0",
    "better-sqlite3": "^9.2.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "inventory",
    "stock-management",
    "ai-assistant",
    "cloudflare-workers",
    "d1-database",
    "shopping-mall"
  ],
  "author": "Huzaifa-12344",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Huzaifa-12344/-StockSense-AI-Inventory-for-a-Shopping-Mall"
  }
}
