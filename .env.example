# ============================================================================
# StockSense: AI Inventory Management System - Environment Variables
# ============================================================================
# IMPORTANT: This file contains example values only.
# Copy to .env.local and fill in your actual credentials.
# NEVER commit real credentials to the repository.
# ============================================================================

# Cloudflare Workers & D1 Database
# ============================================================================
# Get these from https://dash.cloudflare.com/
CLOUDFLARE_ACCOUNT_ID=your_account_id_here
CLOUDFLARE_API_TOKEN=your_api_token_here
D1_DATABASE_ID=your_d1_database_id_here

# API Configuration
# ============================================================================
API_BASE_URL=http://localhost:8787
API_KEY=your_secure_api_key_here_minimum_32_characters
VITE_API_URL=http://localhost:8787/api

# Port Configuration
# ============================================================================
PORT=8787
VITE_PORT=5173

# ChatGPT AI Assistant (OpenAI)
# ============================================================================
# Get API key from https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your_openai_key_here
OPENAI_MODEL=gpt-4
OPENAI_TEMPERATURE=0.7
OPENAI_MAX_TOKENS=1000

# Webhook URLs for Workflows
# ============================================================================
WEBHOOK_LOW_STOCK_ALERT=https://your-service.com/webhooks/low-stock
WEBHOOK_APPROVAL_NOTIFICATION=https://your-service.com/webhooks/approvals

# Notification Settings
# ============================================================================
ADMIN_EMAIL=inventory@nowsheramall.pk
MANAGER_EMAIL=manager@nowsheramall.pk
ENABLE_EMAIL_NOTIFICATIONS=false

# Low-Stock Alert Thresholds
# ============================================================================
LOW_STOCK_THRESHOLD_GROCERY=10
LOW_STOCK_THRESHOLD_CLOTHING=5
LOW_STOCK_THRESHOLD_ELECTRONICS=3
LOW_STOCK_THRESHOLD_HOUSEHOLD=8

# Application Settings
# ============================================================================
NODE_ENV=development
DEBUG=false
LOG_LEVEL=info
APP_TIMEZONE=Asia/Karachi

# Auth Settings
# ============================================================================
# For development: trust X-User-Email header
# For production: use proper auth provider
AUTH_PROVIDER=header
AUTH_MODE=development

# Demo Data
# ============================================================================
SEED_DEMO_DATA=true

# Feature Flags
# ============================================================================
ENABLE_AI_ASSISTANT=true
ENABLE_WORKFLOWS=true
ENABLE_BATCH_IMPORTS=true
MAINTENANCE_MODE=false
